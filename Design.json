{
  "name": "CampThread Design System",
  "colors": {
    "neutral": {
      "50": "#fafafa",
      "100": "#f5f5f5",
      "200": "#e5e5e5",
      "300": "#d4d4d4",
      "400": "#a3a3a3",
      "500": "#737373",
      "600": "#525252",
      "700": "#404040",
      "800": "#262626",
      "900": "#171717"
    },
    "accent": {
      "green": "#22c55e",
      "greenLight": "#dcfce7",
      "greenDark": "#16a34a",
      "coral": "#f43f5e",
      "coralLight": "#ffe4e6",
      "coralDark": "#e11d48",
      "blue": "#3b82f6",
      "blueLight": "#dbeafe",
      "blueDark": "#2563eb"
    },
    "status": {
      "open": { "bg": "#dcfce7", "text": "#16a34a" },
      "full": { "bg": "#fef3c7", "text": "#d97706" },
      "completed": { "bg": "#f5f5f5", "text": "#737373" },
      "assigned": { "bg": "#dbeafe", "text": "#2563eb" },
      "reported": { "bg": "#fee2e2", "text": "#dc2626" },
      "inProgress": { "bg": "#fef3c7", "text": "#d97706" },
      "resolved": { "bg": "#f5f5f5", "text": "#737373" }
    },
    "background": {
      "page": "#f5f5f5",
      "card": "#ffffff",
      "sidebar": "#ffffff"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "display": "ui-sans-serif, system-ui, sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "2.5rem",
    "3xl": "3rem"
  },
  "borderRadius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  },
  "components": {
    "card": {
      "padding": "1.5rem",
      "borderRadius": "0.75rem",
      "shadow": "md",
      "backgroundColor": "#ffffff"
    },
    "button": {
      "primary": { "bg": "#3b82f6", "hover": "#2563eb", "text": "#ffffff" },
      "secondary": { "bg": "#f5f5f5", "hover": "#e5e5e5", "text": "#262626" },
      "success": { "bg": "#22c55e", "hover": "#16a34a", "text": "#ffffff" },
      "danger": { "bg": "#f43f5e", "hover": "#e11d48", "text": "#ffffff" }
    },
    "input": {
      "borderRadius": "0.5rem",
      "border": "1px solid #e5e5e5",
      "padding": "0.5rem 0.75rem",
      "focusRing": "2px solid #3b82f6"
    },
    "badge": {
      "padding": "0.25rem 0.75rem",
      "borderRadius": "9999px",
      "fontSize": "0.75rem",
      "fontWeight": "500"
    }
  }
}
